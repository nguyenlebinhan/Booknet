# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Sao chép file này thành .env và điền thông tin thực tế trước khi chạy:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
PORT=8080
PROJECT_IMAGE=images/

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (LOCAL)
# ------------------------------------------------------------------------------
BOOKNET_DB_URL=jdbc:mysql://localhost:3306/booknet_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
BOOKNET_DB_USER=root
BOOKNET_DB_PASS=your_database_password_here

DB_DIALECT=org.hibernate.dialect.MySQLDialect
DB_DDL_AUTO=update
DB_SHOW_SQL=true

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Email: local SMTP defaults; set authenticated SMTP and TLS for deployment.
APP_BASE_URL=http://localhost:8080
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@booknet.local
MAIL_AUTH=false
MAIL_STARTTLS=false
# Set a long random value to preserve remember-me cookies across restarts.
BOOKNET_REMEMBER_ME_KEY=
